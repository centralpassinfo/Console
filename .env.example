# Console database. Use a dedicated Postgres database, never a venue database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/centralpass_console

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
SESSION_SECRET=

# Browser origin for write-request origin checks. Use the deployed console URL in production.
APP_ORIGIN=http://localhost:5173
PORT=4300
NODE_ENV=development

# Only needed by `npm run admin:create`. Remove them after the account is created.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Separate release worker (same dedicated Console DB and ENCRYPTION_KEY).
# Trusted Platform source only; no credentials in this URL.
RELEASE_REPOSITORY_URL=https://github.com/CentralPass/centralpass-platform.git
# Optional read-only GitHub contents token for a private Platform repository.
RELEASE_GITHUB_TOKEN=
# On Windows use the native executable, not railway.cmd. Linux: railway on PATH.
# RAILWAY_CLI_PATH=C:\Users\agarw\AppData\Roaming\npm\node_modules\@railway\cli\bin\railway.exe
RELEASE_VERIFY_TIMEOUT_MS=900000

# Console API: separate random token (32+ characters) used only by Platform CI
# to publish tested releases. Put the same value in the Platform GitHub secret
# CONSOLE_RELEASE_PUBLISH_TOKEN. Never put it in frontend variables.
RELEASE_PUBLISH_TOKEN=

