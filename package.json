{
  "name": "centralpass-console",
  "version": "1.0.0",
  "private": true,
  "description": "Internal CentralPass venue operations and entitlement console",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,cyan \"node --watch server/src/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/src/index.js",
    "db:migrate": "node server/scripts/migrate.js",
    "admin:create": "node server/scripts/create-admin.js",
    "test": "node --test server/test/*.test.js",
    "check": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.3.0",
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.0",
    "vite": "^8.2.1"
  }
}
